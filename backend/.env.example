# ---------------------------------------------------------------------------
# Phase 1 phone-call pilot — copy into backend/.env and fill in.
# Everything here is optional. The app boots fine with none of it set; the
# pilot endpoints simply report that they are not configured.
# ---------------------------------------------------------------------------

# --- Pilot switches -------------------------------------------------------
# plivo is the only adapter in Phase 1.
PILOT_TELEPHONY_PROVIDER=plivo
# Development-only upload of a real recording for pipeline testing.
# Forced off when NODE_ENV=production.
PILOT_TEST_AUDIO_ENABLED=false

# --- Recording storage -----------------------------------------------------
# Where call recordings are kept.
#   auto  (default) cloud when NODE_ENV=production and Cloudinary credentials
#         are set, local disk otherwise
#   cloud always durable Cloudinary storage (fails loudly if unconfigured)
#   local always the local directory below
# Left on auto outside production on purpose: developer machines and CI hold the
# same credentials as production and must not write real call audio into the
# live Cloudinary account.
PILOT_AUDIO_BACKEND=auto
# Private audio directory. Relative paths resolve from the backend folder.
# Used for the local backend, and as scratch space when a durable recording is
# pulled back down to be transcribed.
# NOTE: on Railway this filesystem is ephemeral. Recordings are only durable
# once PILOT_AUDIO_BACKEND resolves to cloud.
PILOT_AUDIO_DIR=pilot-audio

# Cloudinary account used for product images, and for call recordings when the
# backend above resolves to cloud. The same three values serve both, so there is
# only ever one Cloudinary configuration in this project.
# Without all three, durable storage is unavailable and the app falls back to
# local disk, logging a warning at startup.
CLOUD_NAME=
API_KEY=
API_SECRET=
# 64 MB. Must exceed the largest expected recording (900 s WAV is ~29 MB).
# This is the only place the limit is set; dotenv keeps the last value, so a
# second copy here would silently override the one the code actually reads.
PILOT_MAX_AUDIO_BYTES=67108864
# Delete private pilot recordings after this many days (minimum 1 day). Applies
# to both backends: a durable recording is aged by when it was stored, a local
# file by its last change. A recording a real Order was built from is kept.
PILOT_AUDIO_RETENTION_DAYS=30
# How long a stuck "processing_recording" claim waits before a re-delivered
# callback may retry the pipeline (ms).
PILOT_CLAIM_TIMEOUT_MS=600000

# --- Plivo (pilot telephony) ----------------------------------------------
# Auth Token is also the webhook signing key — never commit it.
# Note the spelling: PILVO, not PLIVO. The code reads PILVO_*.
PILVO_AUTH_ID=
PILVO_AUTH_TOKEN=
# Optional API override, defaults to https://api.plivo.com
PILVO_API_BASE_URL=https://api.plivo.com
# Public HTTPS base URL Plivo calls, no trailing slash, e.g.
# https://esetu-production.up.railway.app
# Required: Plivo signs the exact URL it called, so it must match.
PILVO_WEBHOOK_BASE_URL=
# wav = PCM, so the 16 kHz normaliser can read it (recommended)
# mp3 = smaller, but needs ffmpeg to decode and Sarvam may mis-transcribe it
PILVO_RECORD_FORMAT=wav
# 900 seconds (15 min). 16 kHz mono WAV for this length is ~29 MB.
PILVO_RECORD_MAX_LENGTH=900
# Stop recording after this many SECONDS OF CONTINUOUS SILENCE. A customer
# pauses while thinking or reading a list, so keep this well above a normal
# pause. 15 s truncated real order calls.
PILVO_RECORD_SILENCE_TIMEOUT=60
# Optional spoken prompt on answer. Leave empty to record immediately.
PILVO_ANSWER_PROMPT=
PILVO_DOWNLOAD_TIMEOUT_MS=90000

# --- Sarvam speech-to-text -------------------------------------------------
SARVAM_API_KEY=
# Optional API override, defaults to https://api.sarvam.ai
SARVAM_API_BASE_URL=https://api.sarvam.ai
# batch = up to 2h audio, timestamps + diarization (use this for real calls)
# rest  = under 30s only, no diarization
SARVAM_STT_TRANSPORT=batch
SARVAM_STT_MODEL=saaras:v3
# unknown lets Sarvam auto-detect the language.
SARVAM_STT_LANGUAGE_CODE=unknown
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_LANGUAGE_MODE=transcribe
# Diarization is OFF by default. Measured on a real recording it dropped
# Sarvam's language confidence from 0.72 to 0.00 and returned empty
# transcripts. Set to true only once you have verified it helps your audio.
SARVAM_STT_DIARIZATION=false
# Customer + supplier on the line
SARVAM_STT_NUM_SPEAKERS=2
SARVAM_BATCH_POLL_TIMEOUT_MS=600000
SARVAM_BATCH_UPLOAD_TIMEOUT_MS=300000
SARVAM_REST_TIMEOUT_MS=120000

# --- Audio decoding -------------------------------------------------------
# Every upload format (wav/mp3/m4a/aac/ogg/opus/webm/flac/amr) is normalised to
# 16 kHz mono PCM before STT. WAV is resampled in-process; anything else is
# transcoded with the self-contained ffmpeg-static binary (no root needed).
# Set PILOT_FFMPEG_PATH to use a system ffmpeg instead, or
# PILOT_DISABLE_FFMPEG=true to turn transcoding off.
PILOT_FFMPEG_PATH=
PILOT_DISABLE_FFMPEG=false
PILOT_FFMPEG_TIMEOUT_MS=120000

# --- Review rules (Phase 1) -------------------------------------------------
# An AI line whose reported confidence is below this is shown to the supplier as
# "check this product" instead of being accepted. A line with no reported
# confidence at all is always shown, because silence is not a good match.
PILOT_AMBIGUOUS_CONFIDENCE=0.65
# How long the pickers' read-only catalog projection is reused (ms). Lower it if
# products are added often and the new ones must show up immediately.
PILOT_CATALOG_CACHE_MS=60000

# --- LLM order extraction (OpenAI-compatible chat completions) -------------
# Must support POST {LLM_BASE_URL}/chat/completions
# Must support POST {LLM_BASE_URL}/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
# Must exist in your account and support response_format json_object.
# Verified working: qwen/qwen3.8-27b, openai/gpt-oss-120b
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=90000
# Set to false only if your provider rejects response_format.
LLM_JSON_MODE=true
# Hard cap on the reply. Groq's free tier allows 1000 output tokens/min, so
# asking for more is rejected before the model even starts.
LLM_MAX_TOKENS=900
# Groq's free tier also allows only 7000 input tokens/min, so a large catalog
# cannot be sent whole. If catalog + transcript exceed
# LLM_SINGLE_PASS_TOKEN_BUDGET, a cheap first pass selects just the products the
# customer mentioned and the full detail is sent only for those.
LLM_SINGLE_PASS_TOKEN_BUDGET=4500

# --- MongoDB (local development only) ---------------------------------------
# Some home routers refuse the mongodb+srv parent SRV record while still
# resolving the individual shard hosts, which shows up as
# "querySrv ECONNREFUSED _mongodb._tcp.<cluster>". Pointing Node at public
# resolvers fixes it. Leave unset in production.
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
# Per-request budget for the selection pass, applied per catalog chunk.
LLM_SELECT_TOKEN_BUDGET=3500
# Used only if the selection pass returns nothing at all.
LLM_CATALOG_FALLBACK_LIMIT=15
# The provider's limit is per minute, so one wait usually clears it.
LLM_RATE_LIMIT_RETRIES=1
LLM_RATE_LIMIT_RETRY_WAIT_MS=65000
# Set to true to log input/output token usage per call. Useful when a long order
# is cut off, because it shows whether the input or the output budget is binding.
LLM_DEBUG_TOKENS=false
